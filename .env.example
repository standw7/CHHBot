# Discord Bot Token (required)
DISCORD_TOKEN=

# Discord Application ID (required)
DISCORD_CLIENT_ID=

# Guild ID for development (optional, speeds up slash command registration)
DISCORD_GUILD_ID=

# Log level (optional, default: info)
LOG_LEVEL=info

# Ask Tusky LLM fallback (optional). Unset = Ask Tusky answers presets and live data only
# and deflects everything else.
ANTHROPIC_API_KEY=

# Daily LLM call caps for Ask Tusky (optional, defaults 20 per user / 300 per guild)
# ASK_USER_DAILY_CAP=20
# ASK_GUILD_DAILY_CAP=300
# ASK_SEARCH_DAILY_CAP=15   # web searches per day for Ask Tusky (~$0.015 each); 0 turns search off
